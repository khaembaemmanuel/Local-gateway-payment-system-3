@baseUrl = http://localhost:4000/api
@authToken = {{step2Login.response.body.token}}

### 1. Register a New User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "emmanuel",
  "email": "khaembaz@gmail.com",
  "password": "password123",
  "phoneNumber": "0722833391"
  "accountType": "Savings"
}

###

### 2. Step 1 Login (Request OTP)
POST {{baseUrl}}/auth/login-step1
Content-Type: application/json

{
  "identifier": "emmanuel",
  "password": "password123"
}

###

### 3. Step 2 Verify OTP & Save Token
# @name step2Login
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "identifier": "emmanuel",
  "otp": "976148"
}

###

### 4. Fetch Account Profile
GET {{baseUrl}}/account/profile
Authorization: Bearer {{authToken}}

###

### 5. Initiate M-Pesa STK Push Deposit
POST {{baseUrl}}/payment/stk-push
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "phone": "0722833391",
  "amount": 100
}

###

### 6. Transfer Funds to Another Account
POST {{baseUrl}}/account/transfer
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "recipientAccountNumber": "SRCB654321",
  "amount": 1
}

###

### 7. Simulate M-Pesa Callback (Backend Testing)
POST {{baseUrl}}/payment/mpesa-callback
Content-Type: application/json

{
  "Body": {
    "stkCallback": {
      "MerchantRequestID": "12345-67890-1",
      "CheckoutRequestID": "REPLACE_WITH_CHECKOUT_REQUEST_ID_FROM_STEP_5",
      "ResultCode": 0,
      "ResultDesc": "The service request is processed successfully.",
      "CallbackMetadata": {
        "Item": [
          { "Name": "Amount", "Value": 1 },
          { "Name": "MpesaReceiptNumber", "Value": "QJK1234567" },
          { "Name": "TransactionDate", "Value": 20260731120000 },
          { "Name": "PhoneNumber", "Value": 254703220773 }
        ]
      }
    }
  }
}